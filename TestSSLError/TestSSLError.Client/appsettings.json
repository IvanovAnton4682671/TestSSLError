{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http": "Debug"
    }
  },

  "AllowedHosts": "*",

  "ClientSettings": {
    "ProxyPort": 9001,
    "ProxyBaseUrl": "https://localhost:9001",
    "RequestTimeoutSeconds": 10,
    "EnableConnectionLogging": true
  }
}